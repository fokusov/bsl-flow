{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "agent": {
    "bsl-flow-spec-reviewer": {
      "description": "Independent read-only critic for 1C development specifications",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "variant": "high",
      "temperature": 0.1,
      "steps": 12,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          ".env": "deny",
          ".env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*credentials*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/*credentials*": "deny",
          ".git": "deny",
          ".git/**": "deny",
          "**/.git": "deny",
          "**/.git/**": "deny",
          ".bsl-flow": "deny",
          ".bsl-flow/**": "deny",
          "**/.bsl-flow": "deny",
          "**/.bsl-flow/**": "deny",
          "*.cf": "deny",
          "*.cfe": "deny",
          "*.epf": "deny",
          "*.erf": "deny",
          "*.dt": "deny",
          "*.1cd": "deny",
          "**/*.cf": "deny",
          "**/*.cfe": "deny",
          "**/*.epf": "deny",
          "**/*.erf": "deny",
          "**/*.dt": "deny",
          "**/*.1cd": "deny"
        },
        "glob": {
          "*": "allow",
          "**/*": "deny",
          "**/*.bsl": "allow",
          "**/*.xml": "allow",
          "**/*.md": "allow",
          "**/*.json": "allow",
          "**/*.yaml": "allow",
          "**/*.yml": "allow"
        },
        "grep": "deny",
        "list": {
          "*": "allow",
          ".git": "deny",
          ".git/**": "deny",
          "**/.git": "deny",
          "**/.git/**": "deny",
          ".bsl-flow": "deny",
          ".bsl-flow/**": "deny",
          "**/.bsl-flow": "deny",
          "**/.bsl-flow/**": "deny"
        },
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "question": "deny",
        "doom_loop": "deny"
      },
      "prompt": "{file:./spec-reviewer-prompt.md}"
    },
    "bsl-flow-spec-reviewer-sealed": {
      "description": "Independent sealed critic for 1C development specifications",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "variant": "high",
      "temperature": 0.1,
      "steps": 8,
      "permission": "deny",
      "prompt": "{file:./spec-reviewer-prompt.md}"
    }
  }
}
