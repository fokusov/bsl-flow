{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSL Flow experience memory stage bundle v1",
  "description": "Deterministic, size-bounded, attempt-bound memory selection. Advisory recommendations only: not authorization, evidence, or a gate change. bundle_id hashes the content without bundle_id/bundle_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "project_id", "fingerprints", "records", "excluded", "bundle_id", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"type": "string"},
    "project_id": {"type": "string"},
    "fingerprints": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["policy", "controller", "version", "schema", "toolchain"],
      "properties": {
        "policy": {"type": "string"},
        "controller": {"type": "string"},
        "version": {"type": "string"},
        "schema": {"type": "string"},
        "toolchain": {"type": "string"}
      }
    },
    "records": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "state", "knowledge_class", "risk_class", "scope", "observation", "action", "confirmations", "contradictions", "selected_reason", "task_kind", "error_signatures", "evidence_ref"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "state": {"enum": ["candidate", "shadow", "accepted"]},
          "knowledge_class": {"type": "string", "enum": ["procedural", "diagnostic", "business_rule", "authorization", "test_or_waiver", "architecture", "controller_policy", "model_routing", "runtime_or_external_effect"]},
            "risk_class": {"type": "string", "enum": ["low", "medium", "high"]},
          "task_kind": {"type": "string", "maxLength": 256},
          "error_signatures": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "evidence_ref": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"type": "string", "maxLength": 64},
              "task_id": {"type": ["string", "null"], "maxLength": 256},
              "attempt_id": {"type": ["string", "null"], "maxLength": 256},
              "sha256": {"type": ["string", "null"], "maxLength": 256},
              "policy": {"type": ["string", "null"], "maxLength": 256},
              "controller": {"type": ["string", "null"], "maxLength": 256},
              "version": {"type": ["string", "null"], "maxLength": 256}
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "paths"],
            "properties": {
              "stage": {"type": ["string", "null"]},
              "paths": {"type": "array", "items": {"type": "string"}}
            }
          },
          "observation": {"type": ["string", "null"], "maxLength": 512},
          "action": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": {"enum": ["recommended", "avoid"]},
              "text": {"type": "string", "maxLength": 256}
            }
          },
          "confirmations": {"type": "integer", "minimum": 0},
          "contradictions": {"type": "integer", "minimum": 0},
          "selected_reason": {"enum": ["accepted-knowledge", "shadow-recommendation", "candidate-recommendation"]}
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "reason"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"enum": ["fingerprint-mismatch", "stage-scope-mismatch", "path-scope-mismatch", "task-kind-mismatch", "error-signature-mismatch", "limit-records", "limit-size"]}
        }
      }
    },
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
