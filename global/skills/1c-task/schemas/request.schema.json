{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSL Flow trusted request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "prompt",
    "mode",
    "analysis_goal",
    "complexity",
    "risk",
    "impact_flags",
    "criteria",
    "provenance",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "mode": {
      "enum": [
        "analysis_only",
        "implement"
      ]
    },
    "analysis_goal": {
      "enum": [
        "analysis",
        "specification"
      ]
    },
    "complexity": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "impact_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "permissions",
          "data_migration",
          "data_deletion",
          "posting",
          "data_exchange",
          "form_flow",
          "external_artifact",
          "ambiguous_business_rule"
        ]
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "observation",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "observation": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file_assertion",
              "static",
              "unit",
              "integration",
              "ui",
              "external_artifact"
            ]
          },
          "path": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "report": {
            "type": "string"
          },
          "expected_tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "target": {
            "type": "string"
          },
          "profile": {
            "type": "object"
          },
          "native_1c": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_root", "extension", "module", "platform_version", "executable_sha256", "authorized_operations", "authorization_reference"],
            "properties": {
              "source_root": {"type": "string", "minLength": 1},
              "extension": {"type": "string", "minLength": 1},
              "module": {"type": "string", "minLength": 1},
              "platform_version": {"type": "string", "pattern": "^8\\.3\\.[0-9]+\\.[0-9]+$"},
              "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "authorized_operations": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["inventory", "load", "update", "test"]}},
              "reuse_load_attempt": {"type": "string", "format": "uuid"},
              "authorization_reference": {"type": "string", "minLength": 1}
            }
          },
          "retry_safe": {
            "type": "boolean"
          },
          "protected_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "reference",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "user"
        },
        "reference": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "object",
      "required": [
        "worker",
        "worker_effort",
        "reviewer",
        "reviewer_effort"
      ],
      "additionalProperties": false,
      "properties": {
        "worker": {
          "type": "string"
        },
        "worker_effort": {"type": ["string", "null"]},
        "reviewer": {
          "type": "string"
        },
        "reviewer_effort": {"type": ["string", "null"]}
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "executable", "executable_sha256", "sandbox", "toolset", "denied_read_roots"],
      "properties": {
        "provider": {"enum": ["codex", "opencode"]},
        "codex_skills_sha256": {"$ref": "#/$defs/sha256"},
        "executable": {"$ref": "#/$defs/executable"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "sandbox": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "sha256"],
          "properties": {
            "executable": {"$ref": "#/$defs/executable"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "toolset": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "root", "sha256"],
          "properties": {
            "name": {"enum": ["unica", "cc-1c-skills"]},
            "root": {"$ref": "#/$defs/absolute_path"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "denied_read_roots": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/absolute_path"}
        },
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "sha256", "version", "packages"],
          "properties": {
            "executable": {"$ref": "#/$defs/executable"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "packages": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "contains": {"properties": {"name": {"const": "lxml"}}},
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                  "version": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              }
            }
          }
        },
        "unica": {
          "type": "object", "additionalProperties": false,
          "required": ["plugin_root", "bootstrap_sha256", "manifest_sha256", "runtime_cache", "allowed_tools"],
          "properties": {
            "plugin_root": {"$ref": "#/$defs/absolute_path"},
            "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "runtime_cache": {"$ref": "#/$defs/absolute_path"},
            "allowed_tools": {
              "type": "array", "minItems": 1,
              "items": {"type": "string", "pattern": "^unica\\.(?:(cf|cfe|meta|form|skd|dcs|mxl|role|subsystem|interface|template|code)\\.(info|validate|diff|search|diagnostics|add|edit|remove|compile|init|borrow|patch_method)|project\\.map|code\\.patch)$"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"toolset": {"properties": {"name": {"const": "unica"}}}}},
          "then": {"required": ["unica"]},
          "else": {"not": {"required": ["unica"]}}
        },
        {
          "if": {"properties": {"provider": {"const": "codex"}}},
          "then": {"required": ["codex_skills_sha256"]},
          "else": {"not": {"required": ["codex_skills_sha256"]}}
        },
        {
          "if": {"properties": {"toolset": {"properties": {"name": {"const": "cc-1c-skills"}}}}},
          "then": {"required": ["runtime"]},
          "else": {"not": {"required": ["runtime"]}}
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "limit", "reservation"],
      "properties": {
        "currency": {"enum": ["USD"]},
        "limit": {"type": ["number", "null"], "minimum": 0},
        "reservation": {"type": "number", "minimum": 0}
      },
      "allOf": [{
        "if": {"properties": {"limit": {"type": "null"}}},
        "then": {"properties": {"reservation": {"const": 0}}}
      }]
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "criterion_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "text": {"type": "string", "minLength": 1},
          "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "require_spec_review": {
      "type": "boolean"
    },
    "require_code_review": {
      "type": "boolean"
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_source_repairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14400
    }
  },
  "allOf": [{
    "if": {
      "required": ["execution_profile"],
      "properties": {"execution_profile": {"properties": {"provider": {"const": "opencode"}}}}
    },
    "then": {"properties": {"models": {"properties": {
      "worker": {"const": "deepseek/deepseek-v4-flash"},
      "reviewer": {"const": "deepseek/deepseek-v4-flash"},
      "worker_effort": {"type": "null"},
      "reviewer_effort": {"type": "null"}
    }}}},
    "else": {"properties": {"models": {"properties": {
      "worker": {"pattern": "^[A-Za-z0-9._:-]+$"},
      "reviewer": {"pattern": "^[A-Za-z0-9._:-]+$"},
      "worker_effort": {"enum": ["low", "medium", "high", "xhigh"]},
      "reviewer_effort": {"enum": ["low", "medium", "high", "xhigh"]}
    }}}}
  },
  {
    "if": {"required": ["execution_profile"]},
    "then": {"required": ["budget"]}
  },
  {
    "if": {"required": ["budget"]},
    "then": {"required": ["execution_profile"]}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]).*"},
    "executable": {"type": "string", "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]).*\\.exe$"}
  }
}
