{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "onec-ops/v1/provider.schema.json",
  "title": "onec-ops provider manifest",
  "type": "object",
  "required": ["name", "contract", "capabilities", "detect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "contract": { "const": "onec-ops/v1" },
    "provider_version": { "type": "string" },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["entry", "mode"],
        "additionalProperties": false,
        "properties": {
          "entry": { "type": "string" },
          "mode": { "enum": ["script", "agent_tool"] },
          "requires_authorization": { "type": "boolean" }
        }
      }
    },
    "detect": { "type": "string" }
  }
}
