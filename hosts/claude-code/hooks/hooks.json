{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hosts/claude-code/hooks/SessionStart.ps1\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hosts/claude-code/hooks/PreToolUse-EvidenceGuard.ps1\"" },
          { "type": "command", "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hosts/claude-code/hooks/PreToolUse-EditGate.ps1\"" }
        ]
      }
    ]
  }
}
